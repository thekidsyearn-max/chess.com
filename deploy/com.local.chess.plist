<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Rookery chess server — launchd user agent.

  Install:  run scripts/setup.sh with its service option (see the script header)
            (renders the placeholders, copies this file to ~/Library/LaunchAgents/com.local.chess.plist
             and loads it with `launchctl bootstrap gui/$UID`)
  Stop:     launchctl bootout gui/$UID/com.local.chess
  Logs:     __PROJECT_ROOT__/logs/server.log

  Memory ceiling: the 900 MB RSS limits below are inherited by the Stockfish workers. macOS
  treats RLIMIT_RSS as advisory, so the hard guarantees come from the layers underneath:
  the V8 heap flag (256 MB), SQLite's cache_size / mmap_size pragmas, Stockfish's 32 MB
  hash x 2 single-threaded workers, and the server's own watchdog, which exits when the
  ceiling is crossed so that launchd restarts it clean (KeepAlive).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.chess</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BIN__</string>
    <string>--max-old-space-size=256</string>
    <string>__PROJECT_ROOT__/server/index.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>HOST</key>
    <string>127.0.0.1</string>
    <key>PORT</key>
    <string>8080</string>
    <key>TRUST_PROXY</key>
    <string>1</string>
    <key>STOCKFISH_PATH</key>
    <string>__STOCKFISH_BIN__</string>
    <key>STOCKFISH_PROCESSES</key>
    <string>2</string>
    <key>STOCKFISH_HASH_MB</key>
    <string>32</string>
    <key>MEMORY_CEILING_MB</key>
    <string>900</string>
    <key>ALLOWED_ORIGINS</key>
    <string>__ALLOWED_ORIGINS__</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>Crashed</key>
    <true/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>5</integer>

  <key>ProcessType</key>
  <string>Standard</string>

  <key>SoftResourceLimits</key>
  <dict>
    <key>ResidentSetSize</key>
    <integer>943718400</integer>
    <key>NumberOfFiles</key>
    <integer>4096</integer>
  </dict>

  <key>HardResourceLimits</key>
  <dict>
    <key>ResidentSetSize</key>
    <integer>943718400</integer>
    <key>NumberOfFiles</key>
    <integer>8192</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__PROJECT_ROOT__/logs/server.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_ROOT__/logs/server.log</string>
</dict>
</plist>
